{
  "mcpServers": {
    "redmine-agent": {
      "command": "npx",
      "args": [
        "-y",
        "@muzzamil-khan/redmine-agent-mcp"
      ],
      "env": {
        "REDMINE_BASE_URL": "${user_config.REDMINE_BASE_URL}",
        "REDMINE_API_KEY": "${user_config.REDMINE_API_KEY}",
        "REDMINE_ACTIVITY_ID": "${user_config.REDMINE_ACTIVITY_ID}",
        "REDMINE_BILLABLE_HOURS_FIELD_ID": "${user_config.REDMINE_BILLABLE_HOURS_FIELD_ID}"
      }
    },
    "redmine": {
      "url": "${user_config.REDMINE_SSE_URL}",
      "headers": {
        "x-api-key": "${user_config.REDMINE_SSE_API_KEY}",
        "x-redmine-api-key": "${user_config.REDMINE_API_KEY}"
      }
    },
    "google-sheets": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-google-sheets@latest"
      ],
      "env": {
        "CREDENTIALS_PATH": "${user_config.GOOGLE_SHEETS_CREDENTIALS_PATH}",
        "TOKEN_PATH": "${user_config.GOOGLE_SHEETS_TOKEN_PATH}"
      }
    }
  }
}
